{
  "name": "agent-village",
  "version": "1.0.0",
  "description": "Zero-token Animal Crossing style multi-project visualizer sidecar plugin for Antigravity agents",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/joy4166/Agent-Crossing.git"
  },
  "scripts": {
    "start": "node sidecars/village/main.mjs",
    "install-plugin": "node -e \"const fs=require('fs'),path=require('path'),os=require('os');const dst=path.join(os.homedir(),'.gemini','config','plugins','agent-village');fs.mkdirSync(dst,{recursive:true});fs.cpSync(process.cwd(),dst,{recursive:true,force:true,filter:s=>!s.includes('.impeccable')&&!s.includes('.git')});console.log('Installed plugin to',dst);\""
  }
}
